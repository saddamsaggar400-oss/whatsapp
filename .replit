run = "pnpm dev"
modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
build = ["pnpm", "build"]
run = ["pnpm", "start"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
ADMIN_EMAIL = "almthdtalhwm@gmail.com"
