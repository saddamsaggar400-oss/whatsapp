# Local Node server environment (supply through your shell or process manager)
# CHAT_DB_PATH=/absolute/persistent/path/wisal.sqlite
# CHAT_MEDIA_PATH=/absolute/persistent/path/media
# PORT=5000
# TRUST_PROXY=1
# COOKIE_SECURE=1
# IP_HASH_KEY=long-private-random-string
# Hosted-only settings use the Sites environment tools, not this file:
# ADMIN_EMAIL=owner@example.com
# Optional Web Push: node scripts/generate-push-keys.mjs (run once; preserve the keys).
# VAPID_PUBLIC_KEY=base64url-uncompressed-p256-public-key
# VAPID_PRIVATE_JWK=private-jwk-json
# VAPID_SUBJECT=https://your-site.example/
